{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for local CivicForge data operations.",
  "windows": ["main", "study-widget"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "sql:default",
    "sql:allow-execute",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-always-on-top"
  ]
}
