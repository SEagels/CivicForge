{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CivicForge",
  "version": "0.1.0",
  "identifier": "local.civicforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CivicForge",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 620
      },
      {
        "label": "study-widget",
        "title": "CivicForge 学习小组件",
        "url": "index.html?widget=1",
        "width": 340,
        "height": 220,
        "minWidth": 300,
        "minHeight": 180,
        "maxWidth": 440,
        "maxHeight": 360,
        "visible": false,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:civicforge.db"]
    }
  }
}
